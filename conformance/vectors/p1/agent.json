{
  "$schema": "conex P1 reverse-connect agent registry vectors",
  "cases": [
    {
      "name": "register_lists_capabilities",
      "method": "agent/register",
      "input": {
        "agentId": "agent-1",
        "providerIds": ["notes-local"],
        "methods": ["source/read"],
        "resources": ["notes/a.md"],
        "hostOrigin": "conex://broker.local"
      },
      "expect": "registered"
    },
    {
      "name": "register_unknown_host_rejected",
      "method": "agent/register",
      "input": {
        "agentId": "agent-2",
        "providerIds": ["notes-local"],
        "methods": ["source/read"],
        "resources": ["notes/a.md"],
        "hostOrigin": "http://attacker.example"
      },
      "expect": "bad_request"
    },
    {
      "name": "resolve_returns_matching",
      "method": "agent/resolve",
      "input": {
        "providerId": "notes-local",
        "resourceId": "notes/a.md",
        "method": "source/read"
      },
      "expect": "resolved"
    },
    {
      "name": "heartbeat_updates_timestamp",
      "method": "agent/heartbeat",
      "input": {"agentId": "agent-1"},
      "expect": "heartbeat_accepted"
    }
  ]
}
