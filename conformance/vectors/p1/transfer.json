{
  "$schema": "conex P1 blob wire transfer vectors",
  "cases": [
    {
      "name": "put_chunk_commit_round_trip",
      "method": "blob/{put,chunk,commit}",
      "sizeBytes": 524288,
      "chunkSize": 262144,
      "expect": "committed"
    },
    {
      "name": "chunk_cid_mismatch_rejected",
      "method": "blob/chunk",
      "spoofedCid": true,
      "expect": "bad_blob"
    },
    {
      "name": "commit_short_block_rejected",
      "method": "blob/commit",
      "tamperBlockLength": true,
      "expect": "bad_blob"
    },
    {
      "name": "missing_blocks_listed",
      "method": "blob/commit",
      "missingChunks": [1],
      "expect": "bad_blob"
    }
  ]
}
