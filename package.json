{
  "name": "conex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-Platform Nexus — Anytype ↔ Apple 生态同步桥接",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "conex": "./dist/cli/index.js"
  },
  "scripts": {
    "cli": "bun run src/cli/index.ts",
    "dev": "bun --watch src/cli/index.ts",
    "build": "bun run build:lib && bun run build:cli",
    "build:lib": "bun build --target=node --format=esm --outdir=dist --splitting --sourcemap=external ./src/index.ts",
    "build:cli": "bun build --target=bun --format=esm --outfile=dist/cli/index.js --sourcemap=inline --packages=bundle ./src/cli/index.ts",
    "postbuild": "node scripts/postbuild.mjs",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:anytype": "bun run scripts/anytype-poll.ts",
    "verify:apple": "bun run scripts/apple-test.ts",
    "web": "bun run src/web/server.ts",
    "sync": "bun run src/cli/index.ts sync",
    "status": "bun run src/cli/index.ts status",
    "config": "bun run src/cli/index.ts config",
    "history": "bun run src/cli/index.ts history"
  },
  "dependencies": {
    "@layerc/core": "latest",
    "commander": "^15.0.0",
    "hono": "^4.12.25",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
