{
  "name": "conex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-Platform Nexus — Anytype ↔ Apple 生态同步桥接",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --target=node --format=esm --outdir=dist ./src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:anytype": "bun run scripts/anytype-poll.ts",
    "verify:apple": "bun run scripts/apple-test.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.3"
  }
}