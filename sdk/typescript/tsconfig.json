{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      // Tests import the package by name; resolve the source, not the built
      // dist, so `tsc --noEmit` works on a fresh clone before any build.
      "@conex/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
