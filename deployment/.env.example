# Production deployment config — consumed by Dokploy's Compose stack.
# Dokploy normally lets you set these per-service in the UI; this file
# exists so a single source of truth lives in the repo. Copy to
# deployment/.env locally and let Dokploy inject overrides.
#
# Each variable is documented at the place where it is consumed (host /
# agent TOML or docker-compose env). None of the values below are real;
# Dokploy must replace every <...> placeholder before the stack starts.

# ---- Public origins ----
# Public FQDN the browser visits. Drives CORS / cookie origin checks.
CONEX_PUBLIC_ORIGIN=https://landing.example.com
# Internal origin agents dial — `host_origin` on host + agent must match.
CONEX_HOST_ORIGIN=conex://host.example.internal
# Internal origin agents must pin in TLS verification (`expected_server_name`).
CONEX_INTERNAL_HOSTNAME=host.example.com
# Audience claim that all bearer/ticket signatures share.
CONEX_AUDIENCE=host.example.internal

# ---- Host listener ----
CONEX_HOST_PORT=8787

# ---- Tenant identity ----
CONEX_TENANT_ID=production
# Read-only demo principal for the visitor ("guest") experience. Switch
# web_guest to false in production to require a UI bearer token.
CONEX_WEB_GUEST=true

# ---- Agent identities ----
CONEX_AGENT_A_ID=agent-a
CONEX_AGENT_B_ID=agent-b

# ---- Compose mounts (Dokploy will create the named volumes) ----
CONEX_HOST_CONFIG=./host.toml
CONEX_AGENT_A_CONFIG=./agent-a.toml
CONEX_AGENT_B_CONFIG=./agent-b.toml
CONEX_AGENT_A_DATA=./agent-a-data
CONEX_AGENT_B_DATA=./agent-b-data
# Path inside the container the credential file is mounted at; do NOT
# change unless you also change host.toml / agent-a,b.toml.
CONEX_AGENT_A_TOKEN_FILE=./secrets/agent-a.token
CONEX_AGENT_B_TOKEN_FILE=./secrets/agent-b.token