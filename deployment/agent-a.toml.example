# Start from the repository root:
# CONEX_NODE_TOKEN='<node credential>' cargo run -p conex-agent -- --node-config deployment/agent-a.toml.example
# Replace these installation IDs and approved paths for each node. Never put a
# credential value in the application package or commit it into this file.
node_id = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
node_ref = "home-node"
operator_principal = "01ARZ3NDEKTSV4RRFFQ69G5FAW"
data_dir = "/tmp/conex-node-a"
local_socket = "/tmp/conex-node-a/operator.sock"
applications = ["examples/mvp/node/application.toml"]
permissions = ["counter.read", "counter.add"]

[configs.counter-default]

[publication]
# Local modules remain active when this center is unavailable. This example
# exports only direct-only data, so it never publishes a relay handler.
url = "wss://conex.example/wss"
token_backend = "env:CONEX_NODE_TOKEN"
space_id = "private"
integration_id = "local-apps"
endpoint_prefix = "node-a"
exposure_principals = []
exposure_tenants = []
